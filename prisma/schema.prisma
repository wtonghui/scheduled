// 定时任务管理器 Prisma schema（data-model.md 落地）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum TaskType {
  http
  noop
}

enum RunStatus {
  pending
  running
  succeeded
  failed
  timeout
  dead
  interrupted
  skipped // 上次未结束被跳过的到期 tick（overlapPolicy=skip 的审计行，不计入 maxRuns）
}

enum EmailStatus {
  pending
  in_progress
  sent
  failed
  dead
}

/** 任务停用原因：写时定夺，事后可查（手动停用 / 单次跑完 / 到截止 / 到次数 / 无未来计划 / 历史未知）。 */
enum TaskStopReason {
  manual
  run_once_done
  ends_at
  max_runs
  no_future_schedule
  unknown
}

model Tenant {
  id                String            @id @default(cuid())
  name              String            @db.VarChar(191)
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(6)
  tasks             Task[]
  tokens            ApiToken[]
  emailLogs         EmailLog[]
  webhookDeliveries WebhookDelivery[]

  @@map("tenant")
}

model Task {
  id                      String          @id @default(cuid())
  name                    String          @db.VarChar(191)
  cron                    String?         @db.VarChar(64)
  scheduleIntervalSeconds Int?            @map("schedule_interval_seconds")
  runAt                   DateTime?       @map("run_at") @db.DateTime(6) // 一次性时刻；与 cron/interval 三选一
  timezone                String          @default("Asia/Shanghai") @map("timezone") @db.VarChar(64) // cron 解析用 IANA 时区
  retryDelayMs            Int?            @map("retry_delay_ms") // 同次调度内重试等待基线（毫秒）；null=沿用默认退避
  startsAt                DateTime?       @map("starts_at") @db.DateTime(6) // 重复调度的开始时刻；首跑从此起算
  skipHolidays            Boolean         @default(false) @map("skip_holidays") // 到点遇假日是否跳过/顺延
  holidayPolicy           String          @default("drop") @map("holiday_policy") @db.VarChar(16) // drop 作废 / postpone 顺延到下一工作日同墙钟时刻
  overlapPolicy           String          @default("skip") @map("overlap_policy") @db.VarChar(16) // 上次未结束时：skip 跳过 / queue 排队 / run 允许并行
  endsAt                  DateTime?       @map("ends_at") @db.DateTime(6) // 重复调度的截止时刻；与 maxRuns 可共存（谁先到谁停）
  maxRuns                 Int?            @map("max_runs") // 重复调度的总次数上限（调度触发计，run-now/重试/跳过不计）
  consumedRuns            Int             @default(0) @map("consumed_runs") // 已消耗配额（归档不碰它，配额永不复活）
  taskType                TaskType        @default(http) @map("task_type")
  payload                 Json
  payloadSecrets          Bytes?          @map("payload_secrets") // AES-256-GCM 密文（含 nonce）
  enabled                 Boolean         @default(true)
  disabledReason          TaskStopReason? @map("disabled_reason") // 停用原因（写时定夺；重启用清空）
  disabledAt              DateTime?       @map("disabled_at") @db.DateTime(6) // 停用时刻
  disabledBy              String?         @map("disabled_by") @db.VarChar(191) // 停用人：手动=tokenId，自动=workerId
  maxAttempts             Int             @default(3) @map("max_attempts")
  timeoutMs               Int             @default(30000) @map("timeout_ms")
  recipients              Json
  notifyOn                Json            @default("[\"succeeded\",\"failed\"]") @map("notify_on")
  webhookUrl              String?         @map("webhook_url") @db.Text
  webhookSecret           Bytes?          @map("webhook_secret") // HMAC 密钥（加密存储）
  execSignSecret          Bytes?          @map("exec_sign_secret") // 任务执行请求签名密钥（加密存储；Phase 2 对方按任务验签后启用，当前取值恒走 env）
  emailSubjectTemplate    String?         @map("email_subject_template") @db.VarChar(255)
  emailBodyTemplate       String?         @map("email_body_template") @db.Text
  emailAttachmentUrlTemplate String?      @map("email_attachment_url_template") @db.VarChar(512)
  emailSubjectTemplateFailed String?      @map("email_subject_template_failed") @db.VarChar(255) // 失败专用标题；null=回退成功模板
  emailBodyTemplateFailed String?         @map("email_body_template_failed") @db.Text // 失败专用正文；null=回退成功模板
  nextRunAt               DateTime?       @map("next_run_at") @db.DateTime(6)
  claimedBy               String?         @map("claimed_by") @db.VarChar(64)
  claimedUntil            DateTime?       @map("claimed_until") @db.DateTime(6)
  version                 Int             @default(1)
  tenantId                String          @map("tenant_id")
  ownerTokenId            String          @map("owner_token_id") // 创建该任务的 API token（租户内按 token 隔离视图用）
  systemUserId            String?         @map("system_user_id") @db.VarChar(191) // 系统内用户标识（外部接入系统的具体用户）
  createdAt               DateTime        @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.DateTime(6)
  tenant                  Tenant          @relation(fields: [tenantId], references: [id])
  ownerToken              ApiToken        @relation(fields: [ownerTokenId], references: [id])
  executions              TaskExecution[]

  @@index([nextRunAt, enabled])
  @@index([enabled, nextRunAt, claimedUntil]) // 认领读覆盖（任务 2）
  @@index([claimedUntil])
  @@index([tenantId, nextRunAt])
  @@index([tenantId, enabled])
  @@index([ownerTokenId])
  @@index([tenantId, systemUserId, enabled])
  @@map("task")
}

model TaskExecution {
  id                String            @id @default(cuid())
  taskId            String            @map("task_id")
  idempotencyKey    String            @unique @map("idempotency_key") @db.VarChar(255)
  scheduledAt       DateTime          @map("scheduled_at") @db.DateTime(6)
  startedAt         DateTime?         @map("started_at") @db.DateTime(6)
  finishedAt        DateTime?         @map("finished_at") @db.DateTime(6)
  status            RunStatus         @default(pending)
  attempt           Int
  durationMs        Int?              @map("duration_ms")
  error             Json?
  trigger           String            @db.VarChar(16)
  systemUserId     String?           @map("system_user_id") @db.VarChar(191) // 系统内用户标识
  emailExpected     Boolean           @default(false) @map("email_expected") // 终态时刻判定：这次该不该发邮件（审计用；渲染失败走降级兜底，无自动补单）
  webhookExpected   Boolean           @default(false) @map("webhook_expected") // 终态时刻判定：这次该不该推 webhook
  notifySnapshot    Json?             @map("notify_snapshot") // 通知渲染快照（收件人/模板/webhookUrl/结果等，不含密钥明文）
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(6)
  task              Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  emailLogs         EmailLog[]
  webhookDeliveries WebhookDelivery[]

  @@index([taskId, startedAt])
  @@index([status, startedAt])
  @@map("task_execution")
}

model EmailLog {
  id               BigInt        @id @default(autoincrement())
  runId            String        @unique @map("run_id") @db.VarChar(255)
  taskId           String        @map("task_id") @db.VarChar(191)
  tenantId         String        @map("tenant_id")
  toAddress        String        @map("to_address") @db.Text
  subject          String        @db.VarChar(255)
  html             String?       @db.Text // 渲染后 HTML（outbox 持久化，中继不依赖任务行）
  text             String?       @db.Text // 渲染后纯文本
  status           EmailStatus   @default(pending)
  attempts         Int           @default(0)
  maxAttempts      Int           @default(5) @map("max_attempts")
  messageId        String?       @map("message_id") @db.VarChar(255)
  providerResponse String?       @map("provider_response") @db.Text
  lastError        String?       @map("last_error") @db.Text
  nextRetryAt      DateTime?     @map("next_retry_at") @db.DateTime(6)
  sentAt           DateTime?     @map("sent_at") @db.DateTime(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.DateTime(6)
  systemUserId    String?       @map("system_user_id") @db.VarChar(191) // 系统内用户标识
  attachmentUrl   String?       @map("attachment_url") @db.VarChar(512) // 渲染好的附件下载 URL（来自模板引擎）
  execution        TaskExecution @relation(fields: [runId], references: [id])
  tenant           Tenant        @relation(fields: [tenantId], references: [id])

  @@index([status, nextRetryAt])
  @@index([tenantId])
  @@map("email_log")
}

model ApiToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  prefix     String    @db.VarChar(16)
  lastFour   String    @map("last_four") @db.VarChar(8)
  name       String?   @db.VarChar(191)
  scopes     Json      @default("[]")
  tenantId   String    @map("tenant_id")
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(6)
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(6)
  expiresAt  DateTime? @map("expires_at") @db.DateTime(6)
  createdBy  String?   @map("created_by") @db.VarChar(191)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tasks      Task[]

  @@index([prefix])
  @@index([revokedAt])
  @@index([tenantId])
  @@map("api_token")
}

model WebhookDelivery {
  id            BigInt        @id @default(autoincrement())
  runId         String        @unique @map("run_id") @db.VarChar(255)
  tenantId      String        @map("tenant_id")
  webhookUrl    String        @map("webhook_url") @db.Text
  payload       Json
  webhookSecret Bytes?        @map("webhook_secret") // HMAC 密钥（AES 加密快照，中继验签用）
  status        EmailStatus   @default(pending) // 复用 pending/in_progress/sent/failed/dead
  attempts      Int           @default(0)
  maxAttempts   Int           @default(5) @map("max_attempts")
  signature     String?       @db.VarChar(255)
  responseCode  Int?          @map("response_code")
  lastError     String?       @map("last_error") @db.Text
  nextRetryAt   DateTime?     @map("next_retry_at") @db.DateTime(6)
  sentAt        DateTime?     @map("sent_at") @db.DateTime(6)
  systemUserId String?       @map("system_user_id") @db.VarChar(191) // 系统内用户标识
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime(6)
  execution     TaskExecution @relation(fields: [runId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@index([status, nextRetryAt])
  @@index([tenantId])
  @@map("webhook_delivery")
}

model WorkerLease {
  instanceId      String   @id @map("instance_id") @db.VarChar(64)
  lastHeartbeatAt DateTime @map("last_heartbeat_at") @db.DateTime(6)
  claimedRunIds   Json?    @map("claimed_run_ids")
  status          String   @db.VarChar(16)

  @@index([lastHeartbeatAt])
  @@map("worker_lease")
}
